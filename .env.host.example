# Copy this file to .env on the host. Bun loads .env from the current working
# directory; variables already exported by the shell take precedence.

# Edge router: "tailscale" or "none" (storage only). API authorization is
# enforced in both modes through tailscale whois and tag:ts-site-client.
TS_SITE_ROUTER=tailscale

# Tailscale router credentials and host identity.
TAILSCALE_API_KEY=
TS_SITE_TAILNET=-
# TS_SITE_API_URL=https://api.tailscale.com/api/v2/tailnet/
# TS_SITE_HOSTNAME=m900
TS_SITE_HOST_TAG=tag:ts-site-host
TS_SITE_APPROVAL_TIMEOUT=60000
TS_SITE_DRAIN_TIMEOUT=30000

TS_SITE_DOMAIN=tail37572.ts.net
TS_SITE_ROOT=/srv/sites
TS_SITE_BIND=0.0.0.0
TS_SITE_PORT=8091
# TS_SITE_ENDPOINT_TARGET=127.0.0.1:8091
# TS_SITE_TAILSCALE_BIN=tailscale
