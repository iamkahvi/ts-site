# Copy this file to .env. Both executables load .env from the current working
# directory; variables already exported by the shell take precedence.

TAILSCALE_API_KEY=
TS_SITE_TAILNET=-
# TS_SITE_API_URL=https://api.tailscale.com/api/v2/tailnet/

TS_SITE_DOMAIN=tail37572.ts.net
TS_SITE_HOSTNAME=m900
TS_SITE_HOST_TAG=tag:ts-site-host
TS_SITE_APPROVAL_TIMEOUT=60000

TS_SITE_HOST_URL=http://127.0.0.1:8080
TS_SITE_API_TOKEN=
TS_SITE_ROOT=.sites
TS_SITE_BIND=127.0.0.1
TS_SITE_PORT=8080
TS_SITE_CONFIGURE_TAILSCALE=0
# TS_SITE_ENDPOINT_TARGET=127.0.0.1:8080

# Set to 1 only for local development without Tailscale.
TS_SITE_SKIP_TAILSCALE=0
