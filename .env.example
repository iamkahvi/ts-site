# Copy this file to .env. Both executables load .env from the current working
# directory; variables already exported by the shell take precedence.

# --- Host daemon (src/host.js): storage, origin serving, edge routing ---

# Edge router: "tailscale" or "none" (storage only, for local development).
TS_SITE_ROUTER=tailscale

# Tailscale router (src/routers/tailscale.js): credentials and identity.
TAILSCALE_API_KEY=
TS_SITE_TAILNET=-
# TS_SITE_API_URL=https://api.tailscale.com/api/v2/tailnet/
# TS_SITE_HOSTNAME=m900
TS_SITE_HOST_TAG=tag:ts-site-host
TS_SITE_APPROVAL_TIMEOUT=60000

TS_SITE_DOMAIN=tail37572.ts.net
TS_SITE_ROOT=/srv/sites
TS_SITE_BIND=0.0.0.0
TS_SITE_PORT=8080
TS_SITE_API_TOKEN=
# TS_SITE_ENDPOINT_TARGET=127.0.0.1:8080

# --- CLI (ts-site): a thin client for the host API ---

TS_SITE_HOST_URL=http://m900:8080
# Must match TS_SITE_API_TOKEN on the host; leave unset on both sides to run
# without client authentication.
TS_SITE_API_TOKEN=
